package streams;

import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.List;
import java.util.Map;
import java.util.stream.Collectors;

public class MovieMapping {
    public static void main(String[] args) {
        String path = "data/Movies.txt";

        try {
            List<Movie> movies = Files.lines(Path.of(path))
                    .map(line -> line.trim().split(";"))
                    .filter(parts -> parts.length == 4)
                    .map(parts -> new Movie(
                            parts[0],
                            Integer.parseInt(parts[1]),
                            Double.parseDouble(parts[2]),
                            Integer.parseInt(parts[3])
                    ))
                    .toList();

            movies.forEach(System.out::println);

            Map<String, Movie> byName = movies.stream()
                    .collect(Collectors.toMap(
                            Movie::getName,
                            movie -> movie
                    ));

            System.out.println("Movies by name:");
            System.out.println(byName);

            Map<Integer, Double> avgRatingByYear = movies.stream()
                    .collect(Collectors.groupingBy(
                            Movie::getYear,
                            Collectors.averagingDouble(Movie::getRating)
                    ));

            System.out.println("Average rating by year:");
            avgRatingByYear.forEach((year, avg) ->
                    System.out.println(year + " -> " + avg)
            );

        } catch (IOException e) {
            System.err.println("Something went wrong with reading a file");
        }
    }
}

class Movie {
    private String name;
    private int year;
    private double rating;
    private int delka;

    public Movie(String name, int year, double rating, int delka) {
        this.name = name;
        this.year = year;
        this.rating = rating;
        this.delka = delka;
    }

    @Override
    public String toString() {
        return "Movie -- " +
                "name='" + name + '\'' +
                ", year=" + year +
                ", rating=" + rating +
                ", delka=" + delka;
    }

    public String getName() {
        return name;
    }

    public int getYear() {
        return year;
    }

    public double getRating() {
        return rating;
    }

    public int getDelka() {
        return delka;
    }

    public void setName(String name) {
        this.name = name;
    }

    public void setYear(int year) {
        this.year = year;
    }

    public void setRating(double rating) {
        this.rating = rating;
    }

    public void setDelka(int delka) {
        this.delka = delka;
    }
}
